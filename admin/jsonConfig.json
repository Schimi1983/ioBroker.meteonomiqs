{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tabGeneral": {
      "type": "panel",
      "label": "tab_general",
      "icon": "settings",
      "items": {
        "_headerAccess": {
          "type": "header",
          "size": 2,
          "text": "header_access",
          "newLine": true,
          "xs": 12
        },
        "apiKey": {
          "type": "password",
          "label": "apiKey",
          "help": "apiKey_help",
          "repeat": false,
          "visible": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 6
        },
        "_linkRegister": {
          "type": "staticLink",
          "text": "link_register",
          "href": "https://www.meteonomiqs.com/de/wetter-api/",
          "button": true,
          "variant": "outlined",
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "_headerLocation": {
          "type": "header",
          "size": 2,
          "text": "header_location",
          "newLine": true,
          "xs": 12
        },
        "useSystemLocation": {
          "type": "checkbox",
          "label": "useSystemLocation",
          "help": "useSystemLocation_help",
          "default": true,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 6
        },
        "latitude": {
          "type": "number",
          "label": "latitude",
          "help": "latitude_help",
          "min": -90,
          "max": 90,
          "step": 0.000001,
          "hidden": "!!data.useSystemLocation",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "longitude": {
          "type": "number",
          "label": "longitude",
          "help": "longitude_help",
          "min": -180,
          "max": 180,
          "step": 0.000001,
          "hidden": "!!data.useSystemLocation",
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "language": {
          "type": "select",
          "label": "language",
          "help": "language_help",
          "default": "",
          "options": [
            { "label": "lang_system", "value": "" },
            { "label": "Deutsch", "value": "de" },
            { "label": "English", "value": "en" },
            { "label": "Français", "value": "fr" },
            { "label": "Italiano", "value": "it" },
            { "label": "Español", "value": "es" },
            { "label": "Nederlands", "value": "nl" },
            { "label": "Polski", "value": "pl" },
            { "label": "Čeština", "value": "cs" },
            { "label": "Dansk", "value": "da" },
            { "label": "Română", "value": "ro" },
            { "label": "Slovenčina", "value": "sk" },
            { "label": "Svenska", "value": "sv" }
          ],
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "_headerScope": {
          "type": "header",
          "size": 2,
          "text": "header_scope",
          "newLine": true,
          "xs": 12
        },
        "forecastDays": {
          "type": "number",
          "label": "forecastDays",
          "help": "forecastDays_help",
          "min": 1,
          "max": 14,
          "default": 7,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        }
      }
    },

    "tabSchedule": {
      "type": "panel",
      "label": "tab_schedule",
      "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTEyIDJhMTAgMTAgMCAxIDAgMCAyMCAxMCAxMCAwIDAgMCAwLTIwem0xIDEwLjVWNmgtMnY3LjVsNS41IDMuMy45OS0xLjY0eiIvPjwvc3ZnPg==",
      "items": {
        "_infoSchedule": {
          "type": "staticText",
          "text": "info_schedule",
          "newLine": true,
          "xs": 12
        },
        "updateTimes": {
          "type": "table",
          "label": "updateTimes",
          "help": "updateTimes_help",
          "items": [
            {
              "type": "text",
              "attr": "time",
              "title": "col_time",
              "width": "50%",
              "default": "01:10"
            },
            {
              "type": "number",
              "attr": "tier",
              "title": "col_tier",
              "width": "50%",
              "min": 1,
              "max": 12,
              "default": 1
            }
          ],
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 10,
          "lg": 8
        },
        "_infoTier": {
          "type": "staticText",
          "text": "info_tier",
          "newLine": true,
          "xs": 12
        },
        "minHoursBetweenUpdates": {
          "type": "number",
          "label": "minHoursBetweenUpdates",
          "help": "minHoursBetweenUpdates_help",
          "min": 0,
          "max": 24,
          "default": 5,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        }
      }
    },

    "tabBudget": {
      "type": "panel",
      "label": "tab_budget",
      "icon": "data:image/svg+xml;base64,",
      "items": {
        "_infoBudget": {
          "type": "staticText",
          "text": "info_budget",
          "newLine": true,
          "xs": 12
        },
        "monthlyLimit": {
          "type": "number",
          "label": "monthlyLimit",
          "help": "monthlyLimit_help",
          "min": 0,
          "max": 1000000,
          "default": 100,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "reserveCalls": {
          "type": "number",
          "label": "reserveCalls",
          "help": "reserveCalls_help",
          "min": 0,
          "max": 100,
          "default": 5,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "httpTimeout": {
          "type": "number",
          "label": "httpTimeout",
          "help": "httpTimeout_help",
          "min": 5,
          "max": 120,
          "default": 20,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        },
        "maxRetries": {
          "type": "number",
          "label": "maxRetries",
          "help": "maxRetries_help",
          "min": 0,
          "max": 3,
          "default": 1,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3
        }
      }
    },

    "tabData": {
      "type": "panel",
      "label": "tab_data",
      "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTQgNmgxNnYyLjVINHptMCA1LjVoMTZWMTRINHptMCA1LjVoMTB2Mi41SDR6Ii8+PC9zdmc+",
      "items": {
        "_infoData": {
          "type": "staticText",
          "text": "info_data",
          "newLine": true,
          "xs": 12
        },
        "enableSpaces": {
          "type": "checkbox",
          "label": "enableSpaces",
          "help": "enableSpaces_help",
          "default": true,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "enableHourly": {
          "type": "checkbox",
          "label": "enableHourly",
          "help": "enableHourly_help",
          "default": true,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "hourlyDays": {
          "type": "number",
          "label": "hourlyDays",
          "help": "hourlyDays_help",
          "min": 1,
          "max": 5,
          "default": 2,
          "hidden": "!data.enableHourly",
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "enableCurrent": {
          "type": "checkbox",
          "label": "enableCurrent",
          "help": "enableCurrent_help",
          "default": true,
          "disabled": "!data.enableHourly",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "enableJson": {
          "type": "checkbox",
          "label": "enableJson",
          "help": "enableJson_help",
          "default": true,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "_headerExtras": {
          "type": "header",
          "size": 2,
          "text": "header_extras",
          "newLine": true,
          "xs": 12
        },
        "enableWarnings": {
          "type": "checkbox",
          "label": "enableWarnings",
          "help": "enableWarnings_help",
          "default": true,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "enableAstro": {
          "type": "checkbox",
          "label": "enableAstro",
          "help": "enableAstro_help",
          "default": true,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "enableExtended": {
          "type": "checkbox",
          "label": "enableExtended",
          "help": "enableExtended_help",
          "default": true,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "enableSnow": {
          "type": "checkbox",
          "label": "enableSnow",
          "help": "enableSnow_help",
          "default": true,
          "newLine": false,
          "xs": 12,
          "sm": 6,
          "md": 3
        }
      }
    }
  }
}
