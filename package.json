{
  "name": "iobroker.meteonomiqs",
  "version": "0.2.1",
  "description": "Weather forecast from wetter.com (Meteonomiqs Public Weather API v4.0)",
  "author": {
    "name": "Schimi",
    "email": "szymon.haiduk@world-mg.de"
  },
  "homepage": "https://github.com/Schimi1983/ioBroker.meteonomiqs",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "weather",
    "forecast",
    "wetter.com",
    "meteonomiqs",
    "wetter",
    "vorhersage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Schimi1983/ioBroker.meteonomiqs.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@types/node": "^20.14.10",
    "mocha": "^11.7.6",
    "rimraf": "^5.0.9",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5,png,svg}",
    "admin/build/",
    "build/",
    "LICENSE",
    "io-package.json"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "translate": "translate-adapter",
    "release": "release-script",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/Schimi1983/ioBroker.meteonomiqs/issues"
  },
  "readmeFilename": "README.md"
}
